<p style="color: green"><%= notice %></p>

<% content_for :title, "Messages" %>

<h1>Messages</h1>
<span id="message_counter">Message Count: <%= Message.count %></span>

<div id="new_message">
  <%= render "form", message: Message.new %>
</div>

<div id="messages">
  <%= render @messages %>
</div>

<%= link_to "New message", new_message_path %>
